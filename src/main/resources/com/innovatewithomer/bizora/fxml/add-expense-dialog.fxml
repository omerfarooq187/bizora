<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.innovatewithomer.bizora.controller.AddExpenseController"
      stylesheets="@../css/main.css"
      styleClass="dialog-root"
      spacing="0">

    <!-- Header -->
    <HBox styleClass="dialog-header" alignment="CENTER_LEFT" spacing="10">
        <FontIcon iconLiteral="fas-receipt" iconSize="18" style="-fx-icon-color:#ef4444;"/>
        <Label fx:id="dialogTitleLabel" text="Add Expense" styleClass="dialog-title" HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Body -->
    <VBox styleClass="dialog-body" spacing="14">
        <GridPane hgap="14" vgap="12">
            <columnConstraints>
                <ColumnConstraints prefWidth="130"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Category *" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="categoryCombo" maxWidth="Infinity" editable="true"
                      promptText="Select or type category"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Amount *" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="amountField" promptText="0.00"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Date *" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <DatePicker fx:id="datePicker" maxWidth="Infinity"
                        GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Description" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextArea fx:id="descriptionField" promptText="Optional notes" prefRowCount="2"
                      GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </GridPane>

        <Label fx:id="errorLabel" text="" styleClass="error-message" wrapText="true"/>
    </VBox>

    <!-- Footer -->
    <HBox styleClass="dialog-footer" alignment="CENTER_RIGHT" spacing="10">
        <Button text="Cancel" styleClass="secondary-button" cancelButton="true" onAction="#handleCancel"/>
        <Button text="Save Expense" styleClass="primary-button" defaultButton="true" onAction="#handleSave">
            <graphic><FontIcon iconLiteral="fas-check" iconSize="12"/></graphic>
        </Button>
    </HBox>

</VBox>
