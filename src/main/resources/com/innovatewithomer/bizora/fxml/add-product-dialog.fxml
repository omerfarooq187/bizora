<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.innovatewithomer.bizora.controller.AddProductController"
      stylesheets="@../css/main.css"
      spacing="0"
      prefWidth="500"
      styleClass="dialog-root">

    <HBox styleClass="dialog-header" alignment="CENTER_LEFT" spacing="11">
        <StackPane styleClass="dialog-icon-badge">
            <FontIcon iconLiteral="fas-box-open" iconSize="16"/>
        </StackPane>
        <VBox spacing="2">
            <Label text="Add New Product" styleClass="dialog-title"/>
            <Label text="Create an item and set its initial pricing and stock." styleClass="dialog-subtitle"/>
        </VBox>
    </HBox>

    <VBox styleClass="dialog-body" spacing="14">
    <GridPane hgap="16" vgap="13">
        <columnConstraints>
            <ColumnConstraints prefWidth="126"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Product Name"
               styleClass="form-label"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <TextField fx:id="nameField"
                   promptText="e.g. Dell Latitude 5420"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"
                   GridPane.hgrow="ALWAYS"/>

        <Label text="SKU"
               styleClass="form-label"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <TextField fx:id="skuField"
                   promptText="e.g. LAP-001"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"
                   GridPane.hgrow="ALWAYS"/>

        <Label text="Purchase Price"
               styleClass="form-label"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <TextField fx:id="purchasePriceField"
                   promptText="0.00"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"
                   GridPane.hgrow="ALWAYS"/>

        <Label text="Selling Price"
               styleClass="form-label"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <TextField fx:id="sellingPriceField"
                   promptText="0.00"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="1"
                   GridPane.hgrow="ALWAYS"/>

        <Label text="Opening Stock"
               styleClass="form-label"
               GridPane.rowIndex="4"
               GridPane.columnIndex="0"/>

        <TextField fx:id="stockField"
                   promptText="0"
                   GridPane.rowIndex="4"
                   GridPane.columnIndex="1"
                   GridPane.hgrow="ALWAYS"/>

    </GridPane>
    </VBox>

    <HBox styleClass="dialog-footer" alignment="CENTER_RIGHT" spacing="10">

        <Button text="Cancel"
                styleClass="secondary-button"
                cancelButton="true"
                onAction="#handleCancel"/>

        <Button text="Save Product"
                styleClass="primary-button"
                defaultButton="true"
                onAction="#handleSave">
            <graphic><FontIcon iconLiteral="fas-check" iconSize="12"/></graphic>
        </Button>

    </HBox>

</VBox>
