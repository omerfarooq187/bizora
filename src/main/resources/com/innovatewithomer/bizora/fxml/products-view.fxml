<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.innovatewithomer.bizora.controller.ProductController"
        styleClass="content-root">

    <top>

        <VBox spacing="16">

            <padding>
                <Insets top="24"
                        right="24"
                        bottom="16"
                        left="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT"
                  spacing="12">

                <VBox HBox.hgrow="ALWAYS">

                    <Label text="Products"
                           styleClass="page-title"/>

                    <Label text="Manage your products and inventory."
                           styleClass="page-subtitle"/>

                </VBox>

                <Button text="Add Product"
                        styleClass="primary-button"
                        onAction="#handleAddProduct">

                    <graphic>
                        <FontIcon iconLiteral="fas-plus"
                                  iconSize="14"/>
                    </graphic>

                </Button>

            </HBox>

            <HBox spacing="10">

                <TextField fx:id="searchField"
                           promptText="Search products..."
                           HBox.hgrow="ALWAYS"/>

            </HBox>

        </VBox>

    </top>

    <center>

        <TableView fx:id="productTable"
                   styleClass="product-table">

            <columns>

                <TableColumn fx:id="skuColumn"
                             text="SKU"
                             prefWidth="140"/>

                <TableColumn fx:id="nameColumn"
                             text="Product"
                             prefWidth="250"/>

                <TableColumn fx:id="purchasePriceColumn"
                             text="Purchase Price"
                             prefWidth="160"/>

                <TableColumn fx:id="sellingPriceColumn"
                             text="Selling Price"
                             prefWidth="160"/>

                <TableColumn fx:id="stockColumn"
                             text="Stock"
                             prefWidth="120"/>

                <TableColumn fx:id="actionsColumn"
                             text="Actions"
                             prefWidth="160" />

            </columns>

            <padding>
                <Insets top="0"
                        right="24"
                        bottom="24"
                        left="24"/>
            </padding>

        </TableView>

    </center>

</BorderPane>