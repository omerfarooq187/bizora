<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import javafx.scene.layout.StackPane?>
<BorderPane
        fx:id="rootPane"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.innovatewithomer.bizora.controller.MainController"
        stylesheets="@../css/main.css">

    <!-- =========================
         TOP BAR
         ========================= -->

    <top>

        <HBox styleClass="top-bar"
              alignment="CENTER_LEFT"
              prefHeight="72">

            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="brand-mark">
                    <ImageView fx:id="brandLogoImage" fitWidth="40" fitHeight="40"
                               preserveRatio="true" smooth="true">
                        <image><Image url="@../images/bizora_logo.png"/></image>
                    </ImageView>
                </StackPane>
                <VBox spacing="1">
                    <Label fx:id="businessNameLabel" text="BIZORA" styleClass="app-name"/>
                    <Label text="Business workspace" styleClass="app-kicker"/>
                </VBox>
            </HBox>

            <HBox HBox.hgrow="ALWAYS"/>

            <Button text="Settings" styleClass="top-settings-button"
                    onAction="#showSettings" accessibleText="Open settings"/>

        </HBox>

    </top>


    <!-- =========================
         SIDEBAR
         ========================= -->

    <left>

        <VBox fx:id="sidebar" styleClass="sidebar"
              prefWidth="238" spacing="4">

            <Label fx:id="overviewLabel" text="OVERVIEW" styleClass="nav-section-label"/>

            <Button fx:id="dashboardButton"
                    text="Dashboard"
                    graphicTextGap="12"
                    styleClass="nav-button"
                    maxWidth="Infinity"
                    onAction="#showDashboard">

                <graphic>
                    <FontIcon iconLiteral="fas-home"
                              iconSize="18"/>
                </graphic>

            </Button>

            <Button fx:id="productsButton"
                    text="Products"
                    graphicTextGap="12"
                    styleClass="nav-button"
                    maxWidth="Infinity"
                    onAction="#showProducts">

                <graphic>
                    <FontIcon iconLiteral="fas-box"
                              iconSize="18"/>
                </graphic>

            </Button>

            <Label fx:id="operationsLabel" text="OPERATIONS" styleClass="nav-section-label nav-section-spaced"/>

            <Button fx:id="inventoryButton"
                    text="Inventory"
                    graphicTextGap="12"
                    styleClass="nav-button"
                    maxWidth="Infinity"
                    onAction="#showInventory">

                <graphic>
                    <FontIcon iconLiteral="fas-warehouse"
                              iconSize="18"/>
                </graphic>

            </Button>

            <Button fx:id="purchasesButton"
                    text="Purchases"
                    graphicTextGap="12"
                    styleClass="nav-button"
                    maxWidth="Infinity"
                    onAction="#showPurchases">

                <graphic>
                    <FontIcon iconLiteral="fas-dolly-flatbed"
                              iconSize="18"/>
                </graphic>

            </Button>

            <Button fx:id="salesButton"
                    text="Sales"
                    graphicTextGap="12"
                    styleClass="nav-button"
                    maxWidth="Infinity"
                    onAction="#showSales">

                <graphic>
                    <FontIcon iconLiteral="fas-shopping-cart"
                              iconSize="18"/>
                </graphic>

            </Button>

            <Button fx:id="customersButton"
                    text="Customers"
                    graphicTextGap="12"
                    styleClass="nav-button"
                    maxWidth="Infinity"
                    onAction="#showCustomers">

                <graphic>
                    <FontIcon iconLiteral="fas-users"
                              iconSize="18"/>
                </graphic>

            </Button>

            <Button fx:id="suppliersButton"
                    text="Suppliers"
                    graphicTextGap="12"
                    styleClass="nav-button"
                    maxWidth="Infinity"
                    onAction="#showSuppliers">

                <graphic>
                    <FontIcon iconLiteral="fas-truck"
                              iconSize="18"/>
                </graphic>

            </Button>

            <Button fx:id="expensesButton"
                    text="Expenses"
                    graphicTextGap="12"
                    styleClass="nav-button"
                    maxWidth="Infinity"
                    onAction="#showExpenses">

                <graphic>
                    <FontIcon iconLiteral="fas-money-bill-wave"
                              iconSize="18"/>
                </graphic>

            </Button>

            <Button fx:id="reportsButton"
                    text="Reports"
                    graphicTextGap="12"
                    styleClass="nav-button"
                    maxWidth="Infinity"
                    onAction="#showReports">

                <graphic>
                    <FontIcon iconLiteral="fas-chart-bar"
                              iconSize="18"/>
                </graphic>

            </Button>

            <VBox VBox.vgrow="ALWAYS"/>

            <Separator VBox.vgrow="NEVER"/>

            <Label fx:id="preferencesLabel" text="PREFERENCES" styleClass="nav-section-label nav-section-spaced"/>

            <Button fx:id="settingsButton"
                    text="Settings"
                    graphicTextGap="12"
                    styleClass="nav-button"
                    maxWidth="Infinity"
                    onAction="#showSettings">

                <graphic>
                    <FontIcon iconLiteral="fas-cog"
                              iconSize="18"/>
                </graphic>

            </Button>

            <VBox fx:id="developerFooter" styleClass="developer-footer" spacing="1">
                <Label text="Developed by" styleClass="developer-caption"/>
                <Hyperlink text="InnovateWithOmer" styleClass="developer-link"
                           onAction="#handleOpenDeveloperWebsite"/>
                <Label fx:id="copyrightLabel" text="© 2026 InnovateWithOmer"
                       styleClass="copyright-label"/>
            </VBox>

        </VBox>

    </left>


    <!-- =========================
         MAIN CONTENT
         ========================= -->

    <center>
        <StackPane fx:id="contentArea"
                   styleClass="content-area"/>
    </center>

</BorderPane>
