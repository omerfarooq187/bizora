<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.TextArea?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.VBox?>
        <?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.innovatewithomer.bizora.controller.AdjustStockController"
      spacing="16"
      prefWidth="420"
      styleClass="dialog-container">

    <padding>
        <Insets top="24"
                right="24"
                bottom="24"
                left="24"/>
    </padding>

    <Label text="Adjust Stock"
           styleClass="dialog-title"/>

    <VBox spacing="5">
        <Label text="Product"
               styleClass="field-label"/>

        <Label fx:id="productNameLabel"
               text="Product"
               styleClass="dialog-value"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Current Stock"
               styleClass="field-label"/>

        <Label fx:id="currentStockLabel"
               text="0"
               styleClass="dialog-value"/>
    </VBox>

    <VBox spacing="7">
        <Label text="Actual Stock"
               styleClass="field-label"/>

        <TextField fx:id="actualStockField"
                   promptText="Enter actual stock quantity"/>
    </VBox>

    <VBox spacing="7">
        <Label text="Note"
               styleClass="field-label"/>

        <TextArea fx:id="noteField"
                  promptText="Reason for stock adjustment..."
                  wrapText="true"
                  prefRowCount="4"/>
    </VBox>

    <Label fx:id="errorLabel"
           text=""
           wrapText="true"
           styleClass="error-label"/>

    <HBox spacing="10"
          alignment="CENTER_RIGHT">

        <Button text="Cancel"
                styleClass="secondary-button"
                onAction="#handleCancel"/>

        <Button text="Save Adjustment"
                styleClass="primary-button"
                onAction="#handleSave">

            <graphic>
                <FontIcon iconLiteral="fas-check"
                          iconSize="14"/>
            </graphic>

        </Button>

    </HBox>

</VBox>
