<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.innovatewithomer.bizora.controller.InventoryController"
            stylesheets="@../css/main.css">

    <!-- =====================================================
         TOP
         ===================================================== -->

    <top>

        <HBox spacing="12"
              alignment="CENTER_LEFT"
              styleClass="content-header">

            <Label text="Inventory"
                   styleClass="page-title"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <Button text="Refresh"
                    styleClass="secondary-button"
                    onAction="#handleRefresh">

                <graphic>
                    <FontIcon iconLiteral="fas-sync-alt"
                              iconSize="14"/>
                </graphic>

            </Button>

        </HBox>

    </top>


    <!-- =====================================================
         CENTER
         ===================================================== -->

    <center>

        <VBox spacing="18">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>


            <!-- =================================================
                 PRODUCT SECTION
                 ================================================= -->

            <VBox spacing="10"
                  styleClass="card">

                <Label text="Products"
                       styleClass="section-title"/>

                <TableView fx:id="productTable"
                           VBox.vgrow="ALWAYS"
                           prefHeight="280">

                    <columns>

                        <TableColumn fx:id="idColumn"
                                     text="ID"
                                     prefWidth="60"/>

                        <TableColumn fx:id="nameColumn"
                                     text="Product"
                                     prefWidth="220"/>

                        <TableColumn fx:id="skuColumn"
                                     text="SKU"
                                     prefWidth="150"/>

                        <TableColumn fx:id="stockColumn"
                                     text="Current Stock"
                                     prefWidth="130"/>

                        <TableColumn fx:id="sellingPriceColumn"
                                     text="Selling Price"
                                     prefWidth="130"/>

                    </columns>

                </TableView>

            </VBox>


            <!-- =================================================
                 SELECTED PRODUCT
                 ================================================= -->

            <HBox spacing="20"
                  alignment="CENTER_LEFT"
                  styleClass="card">

                <VBox spacing="5">

                    <Label text="Selected Product"
                           styleClass="muted-label"/>

                    <Label fx:id="selectedProductLabel"
                           text="No product selected"
                           styleClass="value-label"/>

                </VBox>

                <VBox spacing="5">

                    <Label text="Current Stock"
                           styleClass="muted-label"/>

                    <Label fx:id="currentStockLabel"
                           text="—"
                           styleClass="value-label"/>

                </VBox>

                <HBox HBox.hgrow="ALWAYS"/>

                <Button fx:id="adjustStockButton"
                        text="Adjust Stock"
                        styleClass="primary-button"
                        disable="true"
                        onAction="#handleAdjustStock">

                    <graphic>
                        <FontIcon iconLiteral="fas-edit"
                                  iconSize="14"/>
                    </graphic>

                </Button>

            </HBox>


            <!-- =================================================
                 MOVEMENT HISTORY
                 ================================================= -->

            <VBox spacing="10"
                  VBox.vgrow="ALWAYS"
                  styleClass="card">

                <Label text="Inventory Movement History"
                       styleClass="section-title"/>

                <TableView fx:id="movementTable"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="movementTypeColumn"
                                     text="Movement"
                                     prefWidth="140"/>

                        <TableColumn fx:id="quantityColumn"
                                     text="Quantity"
                                     prefWidth="100"/>

                        <TableColumn fx:id="referenceTypeColumn"
                                     text="Reference"
                                     prefWidth="130"/>

                        <TableColumn fx:id="noteColumn"
                                     text="Note"
                                     prefWidth="250"/>

                        <TableColumn fx:id="dateColumn"
                                     text="Date"
                                     prefWidth="180"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>