<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.innovatewithomer.bizora.controller.DashboardController"
        styleClass="dashboard-root">

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
        <content>
        <VBox spacing="24">

            <padding>
                <Insets top="28"
                        right="28"
                        bottom="28"
                        left="28"/>
            </padding>


            <!-- =========================
                 HEADER
                 ========================= -->

            <HBox alignment="CENTER_LEFT"
                  spacing="20">

                <VBox spacing="4"
                      HBox.hgrow="ALWAYS">

                    <Label text="Dashboard"
                           styleClass="page-title"/>

                    <Label text="Overview of your business."
                           styleClass="page-subtitle"/>

                </VBox>

                <Button text="New Sale"
                        styleClass="primary-button"
                        onAction="#handleNewSale">

                    <graphic>

                        <FontIcon iconLiteral="fas-plus"
                                  iconSize="14"/>

                    </graphic>

                </Button>

            </HBox>


            <!-- =========================
                 SUMMARY CARDS
                 ========================= -->

            <GridPane fx:id="metricsGrid" hgap="16"
                      vgap="16">

                <columnConstraints>

                    <ColumnConstraints
                            percentWidth="25"
                            hgrow="ALWAYS"/>

                    <ColumnConstraints
                            percentWidth="25"
                            hgrow="ALWAYS"/>

                    <ColumnConstraints
                            percentWidth="25"
                            hgrow="ALWAYS"/>

                    <ColumnConstraints
                            percentWidth="25"
                            hgrow="ALWAYS"/>

                </columnConstraints>


                <!-- SALES -->

                <VBox GridPane.columnIndex="0"
                      styleClass="dashboard-card"
                      spacing="12">

                    <HBox alignment="CENTER_LEFT">

                        <Label text="Today's Sales"
                               styleClass="card-label"
                               HBox.hgrow="ALWAYS"/>

                        <FontIcon iconLiteral="fas-chart-line"
                                  iconSize="18"
                                  styleClass="card-icon"/>

                    </HBox>

                    <Label fx:id="todaySalesLabel"
                           text="Rs. 0.00"
                           styleClass="card-value"/>

                    <Label text="Total sales today"
                           styleClass="card-description"/>

                </VBox>


                <!-- PURCHASES -->

                <VBox GridPane.columnIndex="1"
                      styleClass="dashboard-card"
                      spacing="12">

                    <HBox alignment="CENTER_LEFT">

                        <Label text="Today's Purchases"
                               styleClass="card-label"
                               HBox.hgrow="ALWAYS"/>

                        <FontIcon iconLiteral="fas-shopping-bag"
                                  iconSize="18"
                                  styleClass="card-icon"/>

                    </HBox>

                    <Label fx:id="todayPurchasesLabel"
                           text="Rs. 0.00"
                           styleClass="card-value"/>

                    <Label text="Total purchases today"
                           styleClass="card-description"/>

                </VBox>


                <!-- EXPENSES -->

                <VBox GridPane.columnIndex="2"
                      styleClass="dashboard-card"
                      spacing="12">

                    <HBox alignment="CENTER_LEFT">

                        <Label text="Today's Expenses"
                               styleClass="card-label"
                               HBox.hgrow="ALWAYS"/>

                        <FontIcon iconLiteral="fas-money-bill-wave"
                                  iconSize="18"
                                  styleClass="card-icon"/>

                    </HBox>

                    <Label fx:id="todayExpensesLabel"
                           text="Rs. 0.00"
                           styleClass="card-value"/>

                    <Label text="Operating expenses"
                           styleClass="card-description"/>

                </VBox>


                <!-- PROFIT -->

                <VBox GridPane.columnIndex="3"
                      styleClass="dashboard-card"
                      spacing="12">

                    <HBox alignment="CENTER_LEFT">

                        <Label text="Today's Profit"
                               styleClass="card-label"
                               HBox.hgrow="ALWAYS"/>

                        <FontIcon iconLiteral="fas-coins"
                                  iconSize="18"
                                  styleClass="card-icon"/>

                    </HBox>

                    <Label fx:id="todayProfitLabel"
                           text="Rs. 0.00"
                           styleClass="card-value"/>

                    <Label text="Estimated net profit"
                           styleClass="card-description"/>

                </VBox>

            </GridPane>


            <!-- =========================
                 SECONDARY STATISTICS
                 ========================= -->

            <HBox spacing="16">

                <VBox styleClass="dashboard-card"
                      spacing="10"
                      HBox.hgrow="ALWAYS">

                    <Label text="Inventory"
                           styleClass="card-label"/>

                    <Label fx:id="totalProductsLabel"
                           text="0"
                           styleClass="stat-value"/>

                    <Label text="Total products"
                           styleClass="card-description"/>

                </VBox>


                <VBox styleClass="dashboard-card"
                      spacing="10"
                      HBox.hgrow="ALWAYS">

                    <Label text="Low Stock"
                           styleClass="card-label"/>

                    <Label fx:id="lowStockLabel"
                           text="0"
                           styleClass="stat-value"/>

                    <Label text="Products requiring attention"
                           styleClass="card-description"/>

                </VBox>


                <VBox styleClass="dashboard-card"
                      spacing="10"
                      HBox.hgrow="ALWAYS">

                    <Label text="Today's Transactions"
                           styleClass="card-label"/>

                    <Label fx:id="todayTransactionsLabel"
                           text="0"
                           styleClass="stat-value"/>

                    <Label text="Sales processed today"
                           styleClass="card-description"/>

                </VBox>

            </HBox>


            <!-- =========================
                 RECENT SALES
                 ========================= -->

            <VBox spacing="12"
                  VBox.vgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="3"
                          HBox.hgrow="ALWAYS">

                        <Label text="Recent Sales"
                               styleClass="section-title"/>

                        <Label text="Latest transactions"
                               styleClass="section-subtitle"/>

                    </VBox>

                    <Button text="View All"
                            styleClass="link-button"
                            onAction="#handleViewSales"/>

                </HBox>


                <TableView fx:id="recentSalesTable"
                           styleClass="dashboard-table"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="invoiceColumn"
                                     text="Invoice"
                                     prefWidth="160"/>

                        <TableColumn fx:id="dateColumn"
                                     text="Date"
                                     prefWidth="180"/>

                        <TableColumn fx:id="customerColumn"
                                     text="Customer"
                                     prefWidth="180"/>

                        <TableColumn fx:id="amountColumn"
                                     text="Amount"
                                     prefWidth="150"/>

                        <TableColumn fx:id="paymentStatusColumn"
                                     text="Payment"
                                     prefWidth="140"/>

                    </columns>

                </TableView>

            </VBox>


            <!-- =========================
                 QUICK ACTIONS
                 ========================= -->

            <VBox spacing="12">

                <Label text="Quick Actions"
                       styleClass="section-title"/>

                <FlowPane hgap="10" vgap="10">

                    <Button text="New Sale"
                            styleClass="secondary-button"
                            onAction="#handleNewSale">

                        <graphic>

                            <FontIcon iconLiteral="fas-shopping-cart"
                                      iconSize="14"/>

                        </graphic>

                    </Button>

                    <Button text="Add Product"
                            styleClass="secondary-button"
                            onAction="#handleAddProduct">

                        <graphic>

                            <FontIcon iconLiteral="fas-box"
                                      iconSize="14"/>

                        </graphic>

                    </Button>

                    <Button text="Stock Adjustment"
                            styleClass="secondary-button"
                            onAction="#handleStockAdjustment">

                        <graphic>

                            <FontIcon iconLiteral="fas-warehouse"
                                      iconSize="14"/>

                        </graphic>

                    </Button>

                    <Button text="Receive Stock"
                            styleClass="secondary-button"
                            onAction="#handleReceiveStock">

                        <graphic>

                            <FontIcon iconLiteral="fas-dolly-flatbed"
                                      iconSize="14"/>

                        </graphic>

                    </Button>

                    <Button text="Add Expense"
                            styleClass="secondary-button"
                            onAction="#handleAddExpense">

                        <graphic>

                            <FontIcon iconLiteral="fas-money-bill-wave"
                                      iconSize="14"/>

                        </graphic>

                    </Button>

                </FlowPane>

            </VBox>

        </VBox>
        </content>
        </ScrollPane>
    </center>

</BorderPane>
